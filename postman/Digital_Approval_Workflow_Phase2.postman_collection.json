{
  "info": {
    "_postman_id": "9f7a3e14-7f0e-4f3b-9f5f-9c1a1d6fe001",
    "name": "Digital Approval Workflow - Phase 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Phase 2 API test collection for auth + full request CRUD with JWT."
  },
  "item": [
    {
      "name": "1) Auth Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/auth/test",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "test"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2) Signup Employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{employee_name}}\",\n  \"email\": \"{{employee_email}}\",\n  \"password\": \"{{employee_password}}\",\n  \"role\": \"employee\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/signup",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "signup"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Signup success or already exists', function () {",
              "  pm.expect([201, 409]).to.include(pm.response.code);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3) Login Employee (set employee_token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{employee_email}}\",\n  \"password\": \"{{employee_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Employee login success', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('employee_token', json.token);",
              "pm.collectionVariables.set('employee_id', String(json.user.id));",
              "pm.test('Employee token present', function () {",
              "  pm.expect(json.token).to.be.a('string').and.not.empty;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4) Create Request (Employee)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{employee_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Phase2 Leave Request\",\n  \"description\": \"Created from Postman collection\",\n  \"type\": \"Leave\",\n  \"fromDate\": \"2026-03-10\",\n  \"toDate\": \"2026-03-11\",\n  \"status\": \"Pending\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/requests/create",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "requests",
            "create"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Request created', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('request_id', String(json.data.id));",
              "pm.test('request_id captured', function () {",
              "  pm.expect(pm.collectionVariables.get('request_id')).to.match(/^\\d+$/);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5) Get Requests (Employee)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{employee_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/requests",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "requests"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Employee requests fetched', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response is array', function () {",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6) Signup Manager",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
