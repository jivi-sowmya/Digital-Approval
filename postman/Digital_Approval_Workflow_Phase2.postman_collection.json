            "{{request_id}}",
            "comment"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Comment updated', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "11) Delete Request (Manager)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{manager_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/requests/{{request_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
