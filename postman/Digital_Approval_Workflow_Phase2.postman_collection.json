        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{manager_name}}\",\n  \"email\": \"{{manager_email}}\",\n  \"password\": \"{{manager_password}}\",\n  \"role\": \"manager\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/signup",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "signup"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Manager signup success or already exists', function () {",
              "  pm.expect([201, 409]).to.include(pm.response.code);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "7) Login Manager (set manager_token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{manager_email}}\",\n  \"password\": \"{{manager_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Manager login success', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('manager_token', json.token);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "8) Get Requests (Manager)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{manager_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/requests",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "requests"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Manager requests fetched', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response is array', function () {",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "9) Approve Request (Manager)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{manager_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Approved\",\n  \"managerComment\": \"Approved by manager via Postman\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/requests/{{request_id}}/status",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "requests",
            "{{request_id}}",
            "status"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status updated', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "10) Update Manager Comment",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{manager_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"managerComment\": \"Updated manager note from Postman\",\n  \"managerCommentUpdatedAt\": \"2026-03-05 13:30\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/requests/{{request_id}}/comment",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
